# Simulation output, not source. Scenario_Export is regenerated by Moving_Radar.ipynb and runs
# to gigabytes (single CSVs above GitHub's 100 MB per-file limit), so it is kept out of the
# repository. The display does not need it here: point it at any export with
#   run_windows.bat --export "C:\path\to\Scenario_Export"
#   MSDF_SCENARIO_EXPORT=/path/to/Scenario_Export ./run_linux.sh
# or with scenario_export.root in MSDF_Display_New/config/display_config.json.
Scenario_Export/

# Jupyter checkpoint copies (they duplicate whatever they shadow)
.ipynb_checkpoints/

# Python
__pycache__/
*.py[cod]

# Virtual environments
.venv/
venv/
