# The virtual environment lives inside the project (the setup scripts create it there).
.venv/
venv/

# Written by the application, never by hand. The export cache is derived from a Scenario
# Export and runs to tens of megabytes, so every cache directory is kept out, whatever
# scenario_export.cache_dir happens to name it.
logs/
cache/
cache_*/

# A Scenario Export copied next to the application: real recorded data, not source.
data/Scenario_Export/
sample_data/

# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/

# Editors and operating systems
.vscode/
.idea/
.DS_Store
Thumbs.db
*.swp
